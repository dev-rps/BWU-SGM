# ==========================================
# Safety Guardian (BWU-SGM) Environment Template
# Copy this file to .env and fill in your credentials.
# ==========================================

# TomTom Maps & Traffic API Key (Used for secondary routing, search, traffic flow & incidents)
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here

# OpenWeatherMap API Key (Used for live weather updates and forecasts)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini AI Key (Used for AI safety assistant chat)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (Optional: high-precision routing, falls back to TomTom/OSRM if empty)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Client Configuration (Auth, Firestore, Storage)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
