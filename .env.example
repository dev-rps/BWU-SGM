# ==========================================
# Safety Guardian (BWU-SGM) Environment Template
# Copy this file to .env and fill in your credentials.
# ==========================================

# TomTom Maps & Traffic API Key (Used for secondary routing, search, traffic flow & incidents)
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here

# OpenWeatherMap API Key (Used for live weather updates and forecasts)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini AI Key (Used for AI safety assistant chat)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (Optional: high-precision routing, falls back to TomTom/OSRM if empty)
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Client Configuration (Postgres Database, Auth, Realtime, Storage)
# Required for user accounts, hazard reports, SOS events, medical profiles, and reviews
VITE_SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Geospatial Python ML Service URL (Hosted on Render or localhost)
# For local dev: http://127.0.0.1:8000
# For production Render: https://safety-guardian-ml.onrender.com
VITE_ML_API_URL=


